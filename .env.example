# ─── Cloudflare ───
CF_AUTH_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_LIST_ID=your-cloudflare-list-id
URL_IPV4=https://feed.example.com/blocklist?type=IPV4&secret=your-feed-secret
URL_IPV6=https://feed.example.com/blocklist?type=IPV6&secret=your-feed-secret

# ─── cdnfly — WAF openresty config, api-key auth (optional: omit to disable) ───
CDNFLY_BASE_URL=http://cdnfly-admin.example.com
CDNFLY_API_KEY=your-cdnfly-api-key
CDNFLY_API_SECRET=your-cdnfly-api-secret
CDNFLY_WAF_CONFIG_ID=global-0-openresty_config-openresty-config

# ─── goedge — EdgeAdmin session login (optional: omit to disable) ───
GOEDGE_BASE_URL=http://goedge-admin.example.com:8000
GOEDGE_USERNAME=your-goedge-username
GOEDGE_PASSWORD=your-goedge-password
GOEDGE_V4_LIST_ID=4
GOEDGE_V6_LIST_ID=5
